# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Where feedback, reports and privacy requests go (shown in the footer and privacy page).
NEXT_PUBLIC_CONTACT_EMAIL=
# Set this to your site's address, e.g. https://so-fly-ai.vercel.app (or your custom domain). Used for
# links in emails and for link previews. Set it explicitly: Vercel's auto-detected address picks the
# shortest domain on the project, which can be an old one.
NEXT_PUBLIC_SITE_URL=

# Optional. Emails you when someone reports a meetup. Server-only, so never prefix with NEXT_PUBLIC_.
# Use a Gmail address and a Google app password (myaccount.google.com/apppasswords).
ALERT_EMAIL_USER=
ALERT_EMAIL_APP_PASSWORD=
# Optional: use another mail service instead of Gmail (for example Brevo). Then ALERT_EMAIL_USER and
# ALERT_EMAIL_APP_PASSWORD are that service's SMTP login and key, and ALERT_EMAIL_FROM is the sender
# address you verified with them.
ALERT_EMAIL_HOST=
ALERT_EMAIL_PORT=
ALERT_EMAIL_FROM=
# Where the alerts go. Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
REPORT_ALERT_EMAIL=

# Optional. Lets SoFly email people (join requests, answers, cancellations, day-before reminders).
# SERVER-ONLY SECRET: it bypasses all security rules. Never prefix it with NEXT_PUBLIC_ and never commit it.
# Find it in Supabase -> Project Settings -> API (the "service_role" / secret key).
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string (try: openssl rand -hex 24). Protects the daily reminder job.
CRON_SECRET=

# Optional. Push notifications. Generate the pair yourself: run `npx web-push generate-vapid-keys`.
# The PUBLIC key is safe to expose (the browser needs it). The PRIVATE key is a secret: never commit it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services should contact about SoFly: mailto:you@example.com. Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
VAPID_SUBJECT=

# Optional. Who can open the /admin page (reports, analytics, meetups). The email(s) you log in to
# SoFly with, comma separated. Server-only, so never prefix with NEXT_PUBLIC_. Empty = no admins.
# Also needs SUPABASE_SERVICE_ROLE_KEY above.
ADMIN_EMAILS=

# Optional. Signs the "bring a friend" invite links. Leave it empty and it is derived from
# SUPABASE_SERVICE_ROLE_KEY, so nothing extra is needed. Set it (any long random string) if you'd rather
# the invite links not depend on that key. Changing it makes previously shared invite links stop working.
INVITE_SECRET=
