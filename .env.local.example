# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Where feedback, reports and privacy requests go (shown in the footer and privacy page).
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional. Set once you have a custom domain, e.g. https://baymeet.app. Used for link previews.
# Until then, Vercel's production URL is used automatically.
NEXT_PUBLIC_SITE_URL=
